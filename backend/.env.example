# ── DeepSeek API 密钥（AI 对话功能必需）──
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ── JWT 签名密钥 -- 必须是强随机字符串（>= 32 字符）──
# 生成方式: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret

# ── 管理员账号（数据库为空时创建，或用于重置弱口令）──
# 注意：仅修改环境变量不会更新已创建的旧账号密码，需执行: npm run reset:admin
# 生产环境必须设置，且长度 >= 8；未设置时生产服务拒绝启动
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# ── 可选: 聊天令牌签名密钥（不设则每次启动随机生成，重启后旧 token 失效）──
# CHAT_TOKEN_SECRET=

# ── 可选: 可信代理层数（Nginx 转发层数，决定 req.ip 取值）──
# 默认 1（一层 Nginx）；无代理直连设为 0
# TRUST_PROXY=1

# ── 可选: 数据库文件路径（默认 backend/data.db，测试可指向内存库）──
# DB_PATH=data.db

# ── 可选: AI 每日预算（防刷费用）──
# AI_DAILY_REQUEST_LIMIT=200
# AI_DAILY_TOKEN_BUDGET=200000

# ── 可选: 前端 SSG 重建（文章增删改后触发 GitHub Actions rebuild workflow）──
# 在 GitHub 仓库 Settings -> Secrets 配置，值需有 actions:write 权限的 PAT
# GITHUB_REBUILD_TOKEN=
# GITHUB_REPO=jxufe-tech/jxufe-tech-web
