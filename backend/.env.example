# DeepSeek API 密钥（AI 对话功能必需）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# JWT 签名密钥 -- 必须是强随机字符串（>= 32 字符）
# 生成方式: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret

# 可选: 聊天令牌签名密钥（不设则每次启动随机生成，重启后旧 token 失效）
# CHAT_TOKEN_SECRET=

# 可选: 管理员账号（仅首次启动、数据库无用户时生效）
# 未设置则回退默认弱口令 admin/admin123，启动时会持续警告
# 生产环境强烈建议在 .env 或 ECS 环境变量中设置为强密码
# 密码入库前会 bcrypt 加盐哈希，.env 里的明文仅用于首次初始化
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-strong-admin-password
